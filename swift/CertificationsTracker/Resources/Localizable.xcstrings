    "settingsTermsAcceptanceBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By accessing or using Certifications Tracker, you agree to these terms. If you do not agree, do not use the app. Sign-in and your data are handled by Supabase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al acceder o usar Certifications Tracker, aceptas estos términos. Si no estás de acuerdo, no uses la app. El inicio de sesión y tus datos los gestiona Supabase."
          }
        }
      }
    },
    "settingsTermsAcceptanceTitle": {
