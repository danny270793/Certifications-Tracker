    "settingsTermsDisclaimerBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifications Tracker is a tool for organizing your own records. It does not verify or issue certifications, and what it shows may be out of date. Always confirm a certification with its provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifications Tracker es una herramienta para organizar tus propios registros. No verifica ni emite certificaciones, y lo que muestra puede estar desactualizado. Confirma siempre una certificación con su proveedor."
          }
        }
      }
    },
    "settingsTermsDisclaimerTitle": {
      "extractionState": "manual",
