    "settingsPrivacyDataBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication is provided by Supabase. Your email and credentials are processed by Supabase; this app does not store your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación la provee Supabase. Tu correo y credenciales los procesa Supabase; esta app no guarda tu contraseña."
          }
        }
      }
    },
    "settingsPrivacyDataTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta"
          }
        }
      }
    },
    "settingsPrivacyInfraBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your certifications, tags and certificate PDFs are stored in Supabase, tied to your account and protected so only you can read them. A copy of the last data loaded is kept on this device to show it offline, and is deleted when you sign out. Verification links open in an in-app browser and are handled by the site they point to. Security and backups depend on that service. Use a strong password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus certificaciones, etiquetas y PDF de certificados se guardan en Supabase, asociados a tu cuenta y protegidos para que solo tú puedas leerlos. En este dispositivo se guarda una copia de los últimos datos cargados para verlos sin conexión, y se borra al cerrar sesión. Los enlaces de verificación se abren en un navegador dentro de la app y los gestiona el sitio al que apuntan. La seguridad y los respaldos dependen de ese servicio. Usa una contraseña segura."
          }
        }
      }
    },
    "settingsPrivacyInfraTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What we store today — and later"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué guardamos hoy — y después"
          }
        }
      }
    },
    "settingsPrivacyNoticeBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text is a simple placeholder, not legal advice. Before production or an app store release, publish a privacy policy that matches your jurisdiction, your organization, and how you actually process data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto es un resumen orientativo, no asesoramiento legal. Antes de producción o de publicar en una tienda de apps, publica una política de privacidad acorde a tu jurisdicción, tu organización y cómo tratas los datos en la práctica."
          }
        }
      }
    },
    "settingsPrivacyNoticeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you ship"
          }
        },
        "es": {
