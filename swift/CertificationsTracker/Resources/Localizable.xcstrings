          }
        }
      }
    },
    "settingsPrivacySharingBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We do not sell your personal information or use your data to target ads. Apart from the sign-in and storage service, this app does not send your data to anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No vendemos tu información personal ni usamos tus datos para mostrarte anuncios. Aparte del servicio de inicio de sesión y almacenamiento, esta app no envía tus datos a nadie."
          }
        }
      }
    },
    "settingsPrivacySharingTitle": {
